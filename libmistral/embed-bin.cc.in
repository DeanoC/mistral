// Generated by libmistral/CMakeLists.txt from embed-bin.cc.in: embeds
// @EMBED_BIN@ as _binary_@EMBED_SYM@_start .. _binary_@EMBED_SYM@_end, the
// symbols GNU "ld -r -b binary" would give it, with only the C++ compiler.

// Mach-O: C symbols take a leading underscore, and the linker may split a
// section at every symbol and reorder the pieces. .alt_entry keeps the end
// symbol inside the piece the start symbol begins.
#if defined(__APPLE__)
#define EMBED_NAME(name) "_" name
#define EMBED_SECTION ".const_data\n"
#define EMBED_ALT_ENTRY(name) ".alt_entry " EMBED_NAME(name) "\n"
#else
#define EMBED_NAME(name) name
#define EMBED_SECTION ".section .rodata\n"
#define EMBED_ALT_ENTRY(name) ""
#endif

__asm__(EMBED_SECTION
        ".p2align 4\n"
        ".globl " EMBED_NAME("_binary_@EMBED_SYM@_start") "\n"
        EMBED_NAME("_binary_@EMBED_SYM@_start") ":\n"
        ".incbin \"@EMBED_BIN@\"\n"
        ".globl " EMBED_NAME("_binary_@EMBED_SYM@_end") "\n"
        EMBED_ALT_ENTRY("_binary_@EMBED_SYM@_end")
        EMBED_NAME("_binary_@EMBED_SYM@_end") ":\n"
        ".text\n");
